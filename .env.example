# Copy to .env.local for local development. NEVER commit real values.
# On Vercel / Render / Firebase App Hosting, set these in the platform's dashboard or secret manager instead.
# Blank optional values are treated as "not set".

# ── Cashfree Payment Gateway (SECRET, server only) ─────────────────────────────────────────────
# Cashfree Merchant Dashboard → Developers → API Keys. Use the sandbox (test) keys until go-live.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# "sandbox" or "production". Production keys + production mode only after Cashfree approves the website.
CASHFREE_ENV=sandbox
# Optional. Cashfree PG API version header. Default: 2025-01-01 (2026-01-01 also works for orders).
CASHFREE_API_VERSION=

# ── Site ──────────────────────────────────────────────────────────────────────────────────────
# Public origin people visit, no trailing path. Every Cashfree return/notify URL and the same-origin
# check are built from it, so it must match the address in the browser exactly (https in production).
SITE_URL=http://localhost:3000

# Recommended (SECRET-ish). Buyers-only WhatsApp group link: shown on the verified thank-you page and
# in the confirmation email, never anywhere else.
WEBINAR_WHATSAPP_URL=

# ── Firebase Firestore (registrations table + already-paid list; key is SECRET) ───────────────
# Firebase console → Project settings → Service accounts → Generate new private key (a JSON file).
# Copy "project_id", "client_email" and "private_key" from it. The key may stay on one line with \n.
# On Firebase App Hosting, leave all three empty: the project and the backend's own account are used.
# Without Firestore, the already-paid list lives in server memory: fine for local testing only.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Resend (confirmation email with the WhatsApp link; key is SECRET) ─────────────────────────
# resend.com → Domains: add and verify your domain first. Then API Keys → Create (sending access).
RESEND_API_KEY=
# Sender on the verified domain, e.g. Priyadharsini Webinar <webinar@your-domain.in>
EMAIL_FROM=
# Optional: where replies go, e.g. the support email.
EMAIL_REPLY_TO=

# ── Rate limiting (recommended in production, SECRET) ─────────────────────────────────────────
# Free Upstash Redis database (https://upstash.com). Without it, limits are per server instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Meta Conversions API (recommended for ads, SECRET token) ──────────────────────────────────
# Events Manager → your Pixel → Settings → Conversions API → Generate access token.
# A Purchase event is sent from the verified webhook for every buyer (hashed email/phone only).
META_PIXEL_ID=
META_CAPI_TOKEN=
# Optional: Events Manager → Test events code, while testing. Remove for real traffic.
META_TEST_EVENT_CODE=
# Optional. Graph API version. Default: v24.0
META_GRAPH_API_VERSION=
# Optional: Business Manager → Brand safety → Domains → Meta-tag method: the content="..." value only.
META_DOMAIN_VERIFICATION=

# ── Public (inlined into browser JavaScript; never put secrets in NEXT_PUBLIC_*) ──────────────
# The Meta Pixel on every page (same number as META_PIXEL_ID). Also opens the CSP for Meta's hosts.
# Must be set at BUILD time.
NEXT_PUBLIC_META_PIXEL_ID=
