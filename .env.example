# Copy this file to ".env" in the project folder on the server (next to package.json) and fill it in.
# Next.js reads it automatically at "npm run build" and "npm start". NEVER commit the real .env (it's in .gitignore).
# After changing a value: run "npm run build" again (for build values) and restart "npm start" (pm2 restart webinar).
# When the server starts, its log says in plain words whether payments are ready (lines starting with [startup]).
# Blank values are treated as "not set".

# ── Razorpay (key secret and webhook secret are SECRET) ─────────────────────────────────────────
# Razorpay Dashboard → Account & Settings → API Keys. Use Test Mode keys (rzp_test_…) until go-live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → Add: URL https://<your-domain>/api/webhooks/razorpay,
# events order.paid + payment.captured, and a secret you make up. Put the same secret here. (Recommended; payments
# are still confirmed by the thank-you page without it.)
RAZORPAY_WEBHOOK_SECRET=
# Optional: name shown at the top of Razorpay's checkout (Razorpay requires it to match the account's
# business name or the website's domain).
RAZORPAY_BRAND_NAME=

# ── Site ──────────────────────────────────────────────────────────────────────────────────────
# Public address people visit, e.g. https://your-domain.in (https required with live keys). Payment return links are built from it.
# Also add it as a build variable, so share previews (og:image) use the right address.
SITE_URL=

# Required (keep it private). Buyers-only WhatsApp group link, e.g. https://chat.whatsapp.com/...: shown only after the
# server verifies the payment. Without it, paid buyers don't get the group button.
WEBINAR_WHATSAPP_URL=

# ── Optional: Firebase Firestore (registrations table + already-paid list; key is SECRET) ─────
# Without it, the already-paid list is kept in the data/ folder (or DATA_DIR) and buyers are in the Razorpay dashboard.
# Firebase console → Project settings → Service accounts → Generate new private key (a JSON file).
# Copy "project_id", "client_email" and "private_key" from it. The key may stay on one line with \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional: where the already-paid list is kept without Firestore (default: data/ next to package.json).
DATA_DIR=

# ── Optional: shared rate limiting (free Upstash Redis; token is SECRET) ──────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Meta Conversions API (recommended for ads; token is SECRET) ───────────────────────────────
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=

# ── Build variables (used while building the pages; not secret) ───────────────────────────────
# These must be in .env when you run "npm run build" (they are written into the pages).
# The Meta Pixel on every page (same number as META_PIXEL_ID). Also opens the security policy for Meta.
NEXT_PUBLIC_META_PIXEL_ID=
# Business Manager → Brand safety → Domains → meta-tag method: the content="..." value only.
META_DOMAIN_VERIFICATION=
