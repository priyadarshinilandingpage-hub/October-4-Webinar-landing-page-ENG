rules_version = '2';

// Only the website's server reads and writes Firestore, with its service account (which bypasses
// these rules). Browsers and apps get nothing: registrations hold names, emails and phone numbers.
// Paste this in Firebase console → Firestore → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
