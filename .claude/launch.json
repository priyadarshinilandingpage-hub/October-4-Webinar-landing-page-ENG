{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-H", "0.0.0.0"],
      "port": 3000
    },
    {
      "name": "web-standalone",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set PORT=3100&& set HOSTNAME=127.0.0.1&& node .next/standalone/server.js"],
      "port": 3100
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--", "-p", "3100"],
      "port": 3100
    }
  ]
}
